# The host libraries the app may load from SteamOS (tools/check-bundle.sh). GPLv3.
# One soname or shell pattern per line. A shipped binary or a library in app/lib that needs anything
# else must find it in app/lib. Every soname taken from the system must also be named in every SteamOS
# build listed in docs/probe/host-sonames/ (check-bundle.sh fails otherwise), so this list is the rule
# and those files are the proof. Nothing here is ever bundled: in particular Mesa (GL, EGL, GBM,
# Vulkan) always comes from the system.

# glibc
libc.so.6
libm.so.6
ld-linux-aarch64.so.1
libdl.so.2
libpthread.so.0
librt.so.1
libresolv.so.2
libutil.so.1
# the C++ runtime (GCC 15 on both builds: GLIBCXX_3.4.34, CXXABI_1.3.15)
libstdc++.so.6
libgcc_s.so.1
# graphics: glvnd, Mesa, Vulkan, DRM, VA-API
libGL.so.1
libEGL.so.1
libGLX.so.0
libOpenGL.so.0
libGLdispatch.so.0
libGLESv2.so.2
libgbm.so.1
libvulkan.so.1
libdrm.so.2
libva.so.2
libva-*.so.2
# the session: Wayland, X11, xcb, xkbcommon, PulseAudio, D-Bus, systemd, SDL2 (sdl2-compat on newer builds)
libwayland-client.so.0
libwayland-cursor.so.0
libwayland-egl.so.1
libX11.so.6
libX11-xcb.so.1
libX*.so.[0-9]*
libSM.so.6
libICE.so.6
libxcb*.so.[0-9]*
libxkbcommon.so.0
libxkbcommon-x11.so.0
libpulse.so.0
libpulse-simple.so.0
libpulse-mainloop-glib.so.0
libdbus-1.so.3
libsystemd.so.0
libudev.so.1
libSDL2-2.0.so.0
# long-stable libraries the system itself is built on (same soname on both builds; the host's own
# libraries load them too, so a second copy in app/lib could clash with them)
libssl.so.3
libcrypto.so.3
libcurl.so.4
libopus.so.0
libz.so.1
libzstd.so.1
libglib-2.0.so.0
libgobject-2.0.so.0
libgio-2.0.so.0
libgmodule-2.0.so.0
libgthread-2.0.so.0
libfontconfig.so.1
libfreetype.so.6
libharfbuzz.so.0
libexpat.so.1
libpng16.so.16
libgssapi_krb5.so.2
libbrotlidec.so.1
libbrotlicommon.so.1   # Qt Network and the system's FreeType both load them
