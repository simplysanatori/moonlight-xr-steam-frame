From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Moonlight XR Native <noreply@example.invalid>
Date: Sat, 31 Oct 2026 14:07:27 +0000
Subject: [PATCH] Hand-off mode: the bitrate is always unlocked, up to 500 Mbps

Moonlight XR Native (lane flat-input). StreamingPreferences::reload() sets unlockBitrate when the hand-off is enabled,
so a config saved with unlockbitrate=false (stock's default) never limits anything to 150 Mbps; the Settings page in
hand-off mode has no Unlock bitrate switch and its bitrate rows go to 500 Mbps. Stock mode keeps stock's switch.
---
 app/settings/streamingpreferences.cpp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/app/settings/streamingpreferences.cpp b/app/settings/streamingpreferences.cpp
index 3a11d77..a0edb24 100644
--- a/app/settings/streamingpreferences.cpp
+++ b/app/settings/streamingpreferences.cpp
@@ -123,6 +123,11 @@ void StreamingPreferences::reload()
     enableYUV444 = settings.value(SER_YUV444, false).toBool();
     bitrateKbps = settings.value(SER_BITRATE, getDefaultBitrate(width, height, fps, enableYUV444)).toInt();
     unlockBitrate = settings.value(SER_UNLOCK_BITRATE, false).toBool();
+    // Moonlight XR Native (lane flat-input): in hand-off mode the bitrate is always unlocked (500 Mbps), whatever an
+    // older config says; the Settings page there has no Unlock bitrate switch. Stock mode keeps stock's.
+    if (MlxrHandoff::enabled()) {
+        unlockBitrate = true;
+    }
     enableVsync = settings.value(SER_VSYNC, true).toBool();
     gameOptimizations = settings.value(SER_GAMEOPTS, true).toBool();
     playAudioOnHost = settings.value(SER_HOSTAUDIO, false).toBool();
